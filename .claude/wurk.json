{
  "wurk": 1,

  "beads": {
    "prefix": "uxpy",
    "sync": "dolthub",
    "topology": "beads",
    "areas": {
      "labels": [
        "area:codec",
        "area:monotonic",
        "area:conformance",
        "area:docs",
        "area:build"
      ],
      "lands_alone": ["area:build"],
      "always_batchable": ["upstream"]
    }
  },

  "forge": {
    "kind": "github",
    "labels": {}
  },

  "gate": {
    "full": ["mise", "run", "gate"],
    "loop": ["mise", "run", "gate:loop"],
    "build_paths": [
      "src/",
      "tests/",
      "scripts/",
      "pyproject.toml",
      "uv.lock",
      "mise.toml",
      ".python-version",
      ".tool-versions",
      "ruff.toml",
      ".ruff.toml",
      "mypy.ini",
      ".mypy.ini",
      "pytest.ini",
      ".coveragerc"
    ],
    "also_gated_paths": ["conformance/", "README.md"],
    "moving_files": [
      "mise.toml",
      "pyproject.toml",
      "ruff.toml",
      ".ruff.toml",
      "mypy.ini",
      ".mypy.ini",
      "pytest.ini",
      ".coveragerc"
    ],
    "sabotage": {
      "test_roots": ["tests/"],
      "test_pattern": "\\bdef\\s+test_",
      "exempt_prefixes": []
    },
    "project_level_skips": [],
    "not_applicable_skips": []
  },

  "parallelism": {
    "model": "worktree-per-issue",
    "worktrees_dir": "../uxid-py-worktrees",
    "trust": ["mise", "trust", "{path}"],
    "warm_clone": [],
    "warm": [["mise", "exec", "--", "uv", "sync", "--frozen"]],
    "repair_when": "uv.lock",
    "repair": [["mise", "exec", "--", "uv", "sync", "--frozen"]],
    "post_branch": []
  },

  "tmux": {
    "session": "uxid-py",
    "model": "opus"
  },

  "models": {
    "direction": "fable"
  },

  "artifacts": {
    "plans": "docs/plans",
    "research": "docs/research",
    "filename": "YYMMDD-[id-]kebab"
  },

  "commits": {
    "style": "s-form",
    "subject_under": 72,
    "body_line_max": 72,
    "total_lines_max": 40,
    "trailer": {
      "key": "Refs"
    }
  },

  "changelog": {
    "mode": "fragments",
    "dir": "changelog.d"
  },

  "release": {
    "kind": "pypi",
    "version_file": "pyproject.toml"
  }
}
